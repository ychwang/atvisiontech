# Goal
# 工艺包文件名，从工作区目录中按文件名查找
string file_name
# 检查通过后是否继续自动导入数据库
bool import_after_check
# 二次处理导入时使用的冲突处理列表JSON；首次检查时可为空
string conflict_list_json
---
# Result
# 结果状态码，约定0成功，非0失败
int16 status
# 结果数据JSON，成功时返回导入结果或冲突列表
string data
# 结果说明信息
string message
---
# Feedback
# 当前总体进度百分比，范围0~100
int32 progress
# 当前阶段标识，例如FILE_VALIDATE、CONFLICT_CHECK、IMPORT_DB
string stage
# 当前步骤显示文案
string current_step
# 当前步骤详细说明
string detail
# 当前已处理数量，例如已检查工艺数
int32 processed_count
# 当前总数量，例如总工艺数
int32 total_count
