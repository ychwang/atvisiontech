# Goal
# 待加载的默认WPP工艺包路径
string source_path
---
# Result
# 结果状态码，约定0成功，非0失败
int16 status
# 结果数据JSON，成功时返回加载结果
string data
# 结果说明信息
string message
---
# Feedback
# 当前总体进度百分比，范围0~100
int32 progress
# 当前阶段标识，例如VALIDATE_PACKAGE、UPDATE_LIBRARY、BUILD_RESULT
string stage
# 当前步骤显示文案
string current_step
# 当前步骤详细说明
string detail
# 当前已处理数量
int32 processed_count
# 当前总数量
int32 total_count
